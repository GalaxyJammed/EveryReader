# Keep Apache POI classes except AWT-dependent drawing components
-keep class !org.apache.poi.xslf.draw.SVGUserAgent, !org.apache.poi.xslf.draw.**, org.apache.poi.** { *; }
-keep class org.apache.xmlbeans.** { *; }
-keep class org.openxmlformats.** { *; }
